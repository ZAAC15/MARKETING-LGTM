# Variables de entorno de referencia. No agregar valores secretos al repositorio.
# Las variables NEXT_PUBLIC_* son visibles en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Configuración del backend
APP_NAME=MARKETING-LGTM API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Solo servidor (API); nunca exponer en el bundle web.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
